# 複製這個檔案成 .env，把金鑰填進去：
#
#   cp .env.example .env
#
# .env 已被 .gitignore 擋掉，不會進 repo。
# 這個 .env.example 只有欄位名稱、沒有值，可以安全 commit。
#
# ⚠️ 不要把金鑰貼進聊天視窗、簡報、README 或任何會截圖的地方。

# OpenRouter 金鑰。格式：sk-or-v1- 開頭，後接一長串英數字。
# 取得處：https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 選用：指定模型。留空則使用 anthropic/claude-sonnet-5
# 其他可選：anthropic/claude-opus-5、google/gemini-2.5-flash
# OPENROUTER_MODEL=anthropic/claude-sonnet-5

# 信任模式：demo | sandbox_strict | production_strict
# demo 保留 MockVerifier 與竄改展示；strict 模式禁止可信驗證降級。
AGENT_TRUST_MODE=demo

# 若 vlei-sandbox 不在專案根目錄，可指定絕對路徑。
# VLEI_SANDBOX_DIR=/absolute/path/to/vlei-sandbox

# Web 安全設定。正式 HTTPS 部署應設 COOKIE_SECURE=1。
COOKIE_SECURE=0
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
MAX_REQUEST_BYTES=1048576

# strict 模式預設關閉公開註冊與竄改 Demo；需要時才明確開啟。
# ALLOW_PUBLIC_REGISTRATION=0
# ENABLE_TAMPER_DEMO=0
